# ========================================
# API密钥配置文件模板
# ========================================
# 说明：这是配置文件的模板，请复制为 secrets.env 并填入真实的API密钥
# 使用步骤：
#   1. 复制此文件: cp secrets.env.template secrets.env
#   2. 编辑 secrets.env 文件，填入你的真实API密钥
#   3. secrets.env 已在 .gitignore 中，不会被上传到GitHub
# ========================================

# Tushare数据源Token
# 获取方式：https://tushare.pro/register 注册后在 https://tushare.pro/user/token 获取
TUSHARE_TOKEN=your_tushare_token_here

# DeepSeek AI API密钥
# 获取方式：https://www.deepseek.com 注册后获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here
